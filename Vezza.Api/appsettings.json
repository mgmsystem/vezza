{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "PublicRegistrationEnabled": false,
    "PublicEndpointRateLimit": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "DemoMode": {
    "Enabled": false,
    "Email": ""
  },
  "Database": {
    "SslMode": "Required",
    "MaximumPoolSize": 5
  },
  "AllowedHosts": "*"
}
